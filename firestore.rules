rules_version = '2';

// Yuztoo — aligned with lib/ Firestore usage (users, merchants, subcollections).
//
// Deploy: firebase deploy --only firestore:rules
// Local validation: cd tools/firebase && npm install && npm run rules:emulator
//   (rules load when Firestore Emulator starts; use project demo-* without login.)
// Review in console before production — this replaces existing rules for matched paths.
//
// Notes:
// - users: collection list/get-all is DENIED. The follower-count helper that scans
//   collection('users') will get permission-denied; the app already treats that as non-fatal.
// - users.status: clients cannot change an existing value (e.g. unblock after admin block).
//   First-time create may set status to "active" only (or omit status).
// - merchants: public read for discovery / storefront; writes only for owner_uid.
// - Subcollections under merchants: owner-only via parent merchant document.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function rolesShapeValid() {
      return ('roles' in request.resource.data)
        && request.resource.data.roles.keys().hasOnly(['client', 'merchant', 'provider'])
        && request.resource.data.roles.client is bool
        && request.resource.data.roles.merchant is bool
        && request.resource.data.roles.provider is bool;
    }

    function noLegacyDottedRoleKeys() {
      return !request.resource.data.keys().hasAny([
        'roles.client',
        'roles.merchant',
        'roles.provider'
      ]);
    }

    function onboardingShapeValid() {
      let o = request.resource.data.onboarding;
      return ('onboarding' in request.resource.data)
        && o is map
        && o.keys().hasOnly(['merchant', 'client'])
        && (!('merchant' in o)
          || (o.merchant is string && o.merchant in ['not_started', 'completed']))
        && (!('client' in o)
          || (o.client is string && o.client in ['not_started', 'completed']));
    }

    // --- /phone_index/{phone} --- E.164 id (same string as users.phone); blocks duplicate phones across UIDs.
    // Unauthenticated get: signup checks existence via transaction.get (evaluated as [get], not [list]).
    // Keep list denied so the collection cannot be enumerated (plain doc.get on some clients uses list).
    match /phone_index/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/phone_index/$(phone));
      allow update: if false;
      allow delete: if false;
    }

    // --- /email_index/{email} --- Lowercased email as doc id; blocks duplicate emails across roles (client/merchant).
    // Same pattern as phone_index: public get so signup can check existence before OTP; list denied.
    match /email_index/{email} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/email_index/$(email));
      allow update: if false;
      allow delete: if false;
    }

    // --- /users/{userId} -------------------------------------------------
    // Block self-service status changes once set; allow first write to "active" (or omit).
    // (Keep conditions inline: resource/request are match-scoped.)
    match /users/{userId} {
      // Merchant CRM: allow a signed-in merchant to read a client's profile only
      // if that client follows them (exists users/{userId}/followed_merchants/{auth.uid}).
      allow get: if isOwner(userId)
        || (isSignedIn() && exists(/databases/$(database)/documents/users/$(userId)/followed_merchants/$(request.auth.uid)));
      allow list: if false;

      allow create: if isOwner(userId) && (
        !('status' in request.resource.data) || request.resource.data.status == 'active'
      ) && onboardingShapeValid() && rolesShapeValid() && noLegacyDottedRoleKeys();

      allow update: if isOwner(userId) && (
        !('status' in resource.data)
          ? (!('status' in request.resource.data) || request.resource.data.status == 'active')
          : resource.data.status == request.resource.data.status
      ) && onboardingShapeValid() && rolesShapeValid() && noLegacyDottedRoleKeys();

      allow delete: if false;
    }

    match /users/{userId}/followed_merchants/{merchantId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // Collection-group rule: lets a signed-in merchant read all followed_merchants
    // docs where merchant_id == their own UID (used by getFollowerIds query).
    // Also allows the merchant OWNER to read even when merchantId != authUid
    // (e.g. merchants created via linkExistingMerchantToUser).
    // Requires a composite index on collection-group followed_merchants / merchant_id.
    match /{path=**}/followed_merchants/{docId} {
      allow read: if isSignedIn()
        && (resource.data.merchant_id == request.auth.uid
          || (exists(/databases/$(database)/documents/merchants/$(resource.data.merchant_id))
            && get(/databases/$(database)/documents/merchants/$(resource.data.merchant_id)).data.owner_uid == request.auth.uid));
    }

    // --- /users/{userId}/notifications/{notificationId} ---
    // Clients read and mark their own notifications.
    // Any signed-in user (merchant) may create notifications for others.
    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isSignedIn();
    }

    // --- /users/{userId}/push_tokens/{tokenId} ---
    // Device FCM tokens: owner read/write only.
    match /users/{userId}/push_tokens/{tokenId} {
      allow read, write: if isOwner(userId);
    }

    // --- /merchants/{merchantId} -----------------------------------------
    function isMerchantOwner(merchantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/merchants/$(merchantId))
        && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner_uid == request.auth.uid;
    }

    match /merchants/{merchantId} {
      // Discovery / vitrine: unauthenticated read OK for this app.
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.owner_uid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.owner_uid == request.auth.uid
        && request.resource.data.owner_uid == resource.data.owner_uid;

      // Any signed-in user (e.g. a client following the merchant) may increment
      // only the monthly connected-clients counter fields. The diff() check ensures
      // no other field is touched.
      allow update: if isSignedIn()
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rappels_monthly_connected_clients', 'rappels_monthly_connected_ym']);

      // Any signed-in user (client completing a passage) may increment only the
      // validated-passage counter fields.
      allow update: if isSignedIn()
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rappels_monthly_validated_passages', 'rappels_monthly_validated_ym']);

      allow delete: if false;
    }

    // --- /merchants/{merchantId}/loyalty_clients/{userId} ---
    // Client: read own row; create/update with bounded increments (MVP — abuse limits only in rules).
    // Merchant owner: full read/write (validation manuelle, ajustements).
    function loyaltyClientDocKeys() {
      // first_visit_at is written on the very first passage and must be
      // included in the allowed set so that doc creation (which uses merge)
      // is not rejected.  All other keys remain unchanged after creation.
      return request.resource.data.keys().hasOnly([
        'validated_passages',
        'pending_passages',
        'cumulative_spend_euros',
        'updated_at',
        'first_visit_at'
      ]);
    }

    function loyaltyClientCreateValid() {
      let r = request.resource.data;
      return loyaltyClientDocKeys()
        && r.validated_passages is int
        && r.pending_passages is int
        && r.cumulative_spend_euros is number
        && r.updated_at is timestamp
        && r.validated_passages >= 0 && r.validated_passages <= 1
        && r.pending_passages >= 0 && r.pending_passages <= 1
        && r.cumulative_spend_euros >= 0 && r.cumulative_spend_euros <= 5000
        // first_visit_at is optional on creation but must be a server timestamp when present.
        && (!r.keys().hasAll(['first_visit_at']) || r.first_visit_at is timestamp);
    }

    function loyaltyClientSelfUpdateValid() {
      let r = request.resource.data;
      let o = resource.data;
      return loyaltyClientDocKeys()
        && r.validated_passages is int
        && r.pending_passages is int
        && r.cumulative_spend_euros is number
        && r.updated_at is timestamp
        && r.validated_passages >= o.validated_passages
        && r.validated_passages <= o.validated_passages + 1
        && r.pending_passages >= o.pending_passages
        && r.pending_passages <= o.pending_passages + 1
        && r.cumulative_spend_euros >= o.cumulative_spend_euros
        && r.cumulative_spend_euros <= o.cumulative_spend_euros + 5000
        // first_visit_at is immutable: clients cannot add or change it after creation.
        // After merge, it will appear in request.resource.data; its value must equal
        // what was stored (i.e., it was not tampered with).
        && (!r.keys().hasAll(['first_visit_at']) || r.first_visit_at == o.get('first_visit_at', null));
    }

    match /merchants/{merchantId}/loyalty_clients/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isMerchantOwner(merchantId));

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && loyaltyClientCreateValid();

      allow update: if isMerchantOwner(merchantId)
        || (isSignedIn()
          && request.auth.uid == userId
          && loyaltyClientSelfUpdateValid());

      // Loyalty history is permanent: once a client earns passages,
      // that record must never be wiped from the client SDK. Any cleanup
      // (e.g. program reset) must go through a privileged Cloud Function
      // (Admin SDK) which bypasses security rules.
      allow delete: if false;
    }

    match /merchants/{merchantId}/promotions/{promoId} {
      allow read: if true;
      allow create, update, delete: if isMerchantOwner(merchantId);
      // Any signed-in user (client viewing a storefront) may increment view_count only.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['view_count']);
    }

    // --- /merchants/{merchantId}/pending_clients/{clientId} ---
    // Written by the client when they follow (so the merchant sees new followers).
    // Merchant reads and deletes (acknowledge). Client can also delete (unfollow cleanup).
    match /merchants/{merchantId}/pending_clients/{clientId} {
      allow read, delete: if isMerchantOwner(merchantId);
      allow create, update: if isSignedIn() && request.auth.uid == clientId;
      allow delete: if isSignedIn() && request.auth.uid == clientId;
    }

    // --- /merchants/{merchantId}/partners/{partnerId} ---
    // Public read (visible on storefront); merchant owner can write.
    match /merchants/{merchantId}/partners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if isMerchantOwner(merchantId);
    }

    match /merchants/{merchantId}/auto_notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isMerchantOwner(merchantId);
    }

    match /merchants/{merchantId}/sent_notifications/{notificationId} {
      allow read: if isMerchantOwner(merchantId);
      // Written by the app (merchant sending a quick notification).
      allow create: if isMerchantOwner(merchantId);
      allow update, delete: if false;
    }
  }
}
