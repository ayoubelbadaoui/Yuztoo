rules_version = '2';

// Yuztoo — aligned with lib/ Firestore usage (users, merchants, subcollections).
//
// Deploy: firebase deploy --only firestore:rules
// Local validation: cd tools/firebase && npm install && npm run rules:emulator
//   (rules load when Firestore Emulator starts; use project demo-* without login.)
// Review in console before production — this replaces existing rules for matched paths.
//
// Notes:
// - users: collection list/get-all is DENIED. The follower-count helper that scans
//   collection('users') will get permission-denied; the app already treats that as non-fatal.
// - users.status: clients cannot change an existing value (e.g. unblock after admin block).
//   First-time create may set status to "active" only (or omit status).
// - merchants: public read for discovery / storefront; writes only for owner_uid.
// - Subcollections under merchants: owner-only via parent merchant document.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function rolesShapeValid() {
      return ('roles' in request.resource.data)
        && request.resource.data.roles.keys().hasOnly(['client', 'merchant', 'provider'])
        && request.resource.data.roles.client is bool
        && request.resource.data.roles.merchant is bool
        && request.resource.data.roles.provider is bool;
    }

    function noLegacyDottedRoleKeys() {
      return !request.resource.data.keys().hasAny([
        'roles.client',
        'roles.merchant',
        'roles.provider'
      ]);
    }

    function onboardingShapeValid() {
      let o = request.resource.data.onboarding;
      return ('onboarding' in request.resource.data)
        && o is map
        && o.keys().hasOnly(['merchant', 'client'])
        && (!('merchant' in o)
          || (o.merchant is string && o.merchant in ['not_started', 'completed']))
        && (!('client' in o)
          || (o.client is string && o.client in ['not_started', 'completed']));
    }

    // --- /phone_index/{phone} --- E.164 id (same string as users.phone); blocks duplicate phones across UIDs.
    // Unauthenticated get: signup checks existence via transaction.get (evaluated as [get], not [list]).
    // Keep list denied so the collection cannot be enumerated (plain doc.get on some clients uses list).
    match /phone_index/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/phone_index/$(phone));
      allow update: if false;
      allow delete: if false;
    }

    // --- /email_index/{email} --- Lowercased email as doc id; blocks duplicate emails across roles (client/merchant).
    // Same pattern as phone_index: public get so signup can check existence before OTP; list denied.
    match /email_index/{email} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/email_index/$(email));
      allow update: if false;
      allow delete: if false;
    }

    // --- /users/{userId} -------------------------------------------------
    // Block self-service status changes once set; allow first write to "active" (or omit).
    // (Keep conditions inline: resource/request are match-scoped.)
    match /users/{userId} {
      // Merchant CRM: allow a signed-in merchant to read a client's profile only
      // if that client follows them (exists users/{userId}/followed_merchants/{auth.uid}).
      allow get: if isOwner(userId)
        || (isSignedIn() && exists(/databases/$(database)/documents/users/$(userId)/followed_merchants/$(request.auth.uid)));
      allow list: if false;

      allow create: if isOwner(userId) && (
        !('status' in request.resource.data) || request.resource.data.status == 'active'
      ) && onboardingShapeValid() && rolesShapeValid() && noLegacyDottedRoleKeys();

      allow update: if isOwner(userId) && (
        !('status' in resource.data)
          ? (!('status' in request.resource.data) || request.resource.data.status == 'active')
          : resource.data.status == request.resource.data.status
      ) && onboardingShapeValid() && rolesShapeValid() && noLegacyDottedRoleKeys();

      allow delete: if false;
    }

    match /users/{userId}/followed_merchants/{merchantId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // --- /users/{userId}/blocked_merchants/{merchantId} ---
    // Per-user blocklist of merchants the user no longer wishes to receive
    // notifications from or see in their carnet/recommendations. Strictly
    // private to the owning user — merchants must NOT learn they were blocked
    // (App Store guideline 1.2: blocking should be silent and one-sided).
    // Cloud Functions read this via collection-group; the rule below allows
    // owner-only read/write at the per-doc path. Writes are constrained to
    // an empty / `created_at`-only payload to minimise data exposure.
    match /users/{userId}/blocked_merchants/{merchantId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['created_at'])
        && (
          !('created_at' in request.resource.data)
          || request.resource.data.created_at is timestamp
        );
    }

    // Collection-group rule: lets a signed-in merchant read all followed_merchants
    // docs where merchant_id == their own UID (used by getFollowerIds query).
    // Also allows the merchant OWNER to read even when merchantId != authUid
    // (e.g. merchants created via linkExistingMerchantToUser).
    // Requires a composite index on collection-group followed_merchants / merchant_id.
    match /{path=**}/followed_merchants/{docId} {
      allow read: if isSignedIn()
        && (resource.data.merchant_id == request.auth.uid
          || (exists(/databases/$(database)/documents/merchants/$(resource.data.merchant_id))
            && get(/databases/$(database)/documents/merchants/$(resource.data.merchant_id)).data.owner_uid == request.auth.uid));
    }

    // --- /users/{userId}/loyalty_bons/{bonId} ---
    // Per-client persisted reward bons. Issued by Cloud Functions when a
    // welcome bon is unlocked (first visit) or a milestone threshold is
    // crossed; carry an optional `valid_until_at` so the scheduled
    // expiration CF can warn the client and mark expired ones. Strictly
    // server-written: clients read but never create/update. The
    // redemption mark (redeemed_at) is set server-side too — when the
    // merchant decrements validated_passages or the client claims the
    // welcome bon, the corresponding loyalty_clients write fires
    // onLoyaltyProgressUpdated which mirrors the change here.
    match /users/{userId}/loyalty_bons/{bonId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // --- /users/{userId}/notifications/{notificationId} ---
    // Clients read and mark their own notifications.
    // Merchant-originated creates must claim a merchant_id the caller actually owns.
    // This prevents any signed-in user from injecting fake notifications that
    // impersonate another merchant's name/id (cross-promotion / spam attack).
    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isSignedIn()
        && (
          // No merchant_id field (or empty string): system/legacy path — permitted.
          !('merchant_id' in request.resource.data)
          || request.resource.data.merchant_id == ''
          // Merchant-originated: the caller must own the referenced merchant.
          || isMerchantOwner(request.resource.data.merchant_id)
        );
    }

    // --- /users/{userId}/push_tokens/{tokenId} ---
    // Device FCM tokens: owner read/write only.
    match /users/{userId}/push_tokens/{tokenId} {
      allow read, write: if isOwner(userId);
    }

    // --- /merchants/{merchantId} -----------------------------------------
    function isMerchantOwner(merchantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/merchants/$(merchantId))
        && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner_uid == request.auth.uid;
    }

    match /merchants/{merchantId} {
      // Discovery / vitrine: unauthenticated read OK for this app.
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.owner_uid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.owner_uid == request.auth.uid
        && request.resource.data.owner_uid == resource.data.owner_uid;

      // Any signed-in user (e.g. a client following the merchant) may increment
      // only the monthly connected-clients counter fields. The diff() check ensures
      // no other field is touched.
      allow update: if isSignedIn()
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rappels_monthly_connected_clients', 'rappels_monthly_connected_ym']);

      // Any signed-in user (client completing a passage) may increment only the
      // validated-passage counter fields.
      allow update: if isSignedIn()
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rappels_monthly_validated_passages', 'rappels_monthly_validated_ym']);

      allow delete: if false;
    }

    // --- /merchants/{merchantId}/loyalty_clients/{userId} ---
    // Client: read own row; create/update with bounded increments (MVP — abuse limits only in rules).
    // Merchant owner: full read/write (validation manuelle, ajustements).
    function loyaltyClientDocKeys() {
      // first_visit_at is written on the very first passage and must be
      // included in the allowed set so that doc creation (which uses merge)
      // is not rejected.  All other keys remain unchanged after creation.
      // last_passage_at is the cooldown anchor — server timestamp written by
      // the client SDK on every additive passage; immutable to monotonic time.
      // welcome_bon_claimed_at is a one-shot timestamp written by the client
      // when they redeem the welcome bon. Once set it must never be cleared.
      return request.resource.data.keys().hasOnly([
        'validated_passages',
        'pending_passages',
        'cumulative_spend_euros',
        'updated_at',
        'first_visit_at',
        'last_passage_at',
        'welcome_bon_claimed_at',
        'enrolled_loyalty_program',
        'enrolled_at',
        'program_status'
      ]);
    }

    // Merchant-side create: the merchant validates a client's first passage
    // and the loyalty_clients doc is born from that synchronous write. The
    // legacy client-side create path (writing pending_passages = 1) is gone —
    // there is no pending state anymore. Pending sessions live in the
    // `active_validations` subcollection until the merchant submits the form.
    function loyaltyClientMerchantCreateValid() {
      let r = request.resource.data;
      return loyaltyClientDocKeys()
        && r.validated_passages is int
        && r.cumulative_spend_euros is number
        && r.updated_at is timestamp
        && r.validated_passages >= 0
        && r.cumulative_spend_euros >= 0
        && (!r.keys().hasAll(['first_visit_at']) || r.first_visit_at is timestamp)
        && (!r.keys().hasAll(['last_passage_at']) || r.last_passage_at is timestamp);
    }

    // Client self-update: the only mutation a client can make to their own
    // loyalty_clients doc is to claim the welcome bon (one-shot
    // welcome_bon_claimed_at: null → server timestamp). Every counter is
    // merchant-only — the client no longer writes pending_passages or any
    // passage delta; that responsibility moved to the merchant on validation.
    function loyaltyClientSelfUpdateValid() {
      let r = request.resource.data;
      let o = resource.data;
      return loyaltyClientDocKeys()
        && r.validated_passages == o.validated_passages
        // Legacy `pending_passages` may persist on old docs — tolerate it but
        // forbid client-side mutation.
        && (!r.keys().hasAll(['pending_passages'])
            || r.pending_passages == o.get('pending_passages', 0))
        && r.cumulative_spend_euros == o.cumulative_spend_euros
        // first_visit_at, last_passage_at, enrolled_* are merchant-managed.
        && (!r.keys().hasAll(['first_visit_at'])
            || r.first_visit_at == o.get('first_visit_at', null))
        && (!r.keys().hasAll(['last_passage_at'])
            || r.last_passage_at == o.get('last_passage_at', null))
        && (
          !r.keys().hasAll(['welcome_bon_claimed_at'])
          || (
            o.get('welcome_bon_claimed_at', null) == null
              && r.welcome_bon_claimed_at is timestamp
          )
          || r.welcome_bon_claimed_at == o.get('welcome_bon_claimed_at', null)
        )
        && (!r.keys().hasAll(['enrolled_loyalty_program'])
            || r.enrolled_loyalty_program == o.get('enrolled_loyalty_program', null))
        && (!r.keys().hasAll(['enrolled_at'])
            || r.enrolled_at == o.get('enrolled_at', null))
        && (!r.keys().hasAll(['program_status'])
            || r.program_status == o.get('program_status', null));
    }

    match /merchants/{merchantId}/loyalty_clients/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isMerchantOwner(merchantId));

      // Only the merchant can create — the doc is born on first validation.
      allow create: if isMerchantOwner(merchantId)
        && loyaltyClientMerchantCreateValid();

      allow update: if isMerchantOwner(merchantId)
        || (isSignedIn()
          && request.auth.uid == userId
          && loyaltyClientSelfUpdateValid());

      // Loyalty history is permanent: once a client earns passages,
      // that record must never be wiped from the client SDK. Any cleanup
      // (e.g. program reset) must go through a privileged Cloud Function
      // (Admin SDK) which bypasses security rules.
      allow delete: if false;
    }

    // --- /merchants/{merchantId}/active_validations/{clientUid} ---
    // Live "passage validation" sessions. The client taps "Demander un passage"
    // on the merchant's vitrine → this doc is created with status='awaiting'.
    // The merchant's app listens on the merchant-scoped collection and pops a
    // smart per-program form. On submit the merchant flips status to
    // 'completed' (and writes the deltas to loyalty_clients). On dismiss,
    // 'cancelled'. The doc id is the client's uid, so a re-tap overwrites a
    // stale completed/cancelled session.
    function activeValidationSessionPayloadValid() {
      let r = request.resource.data;
      return r.keys().hasAll(['client_uid', 'client_display_name', 'created_at', 'status', 'program_snapshot'])
        && r.keys().hasOnly([
            'client_uid', 'client_display_name', 'client_photo_url',
            'created_at', 'status', 'program_snapshot'
          ])
        && r.client_display_name is string
        && r.status == 'awaiting'
        && r.created_at is timestamp
        && r.program_snapshot is map
        && (!r.keys().hasAll(['client_photo_url']) || r.client_photo_url is string);
    }

    function activeValidationCreateValid() {
      let r = request.resource.data;
      return activeValidationSessionPayloadValid()
        && r.client_uid == request.auth.uid;
    }

    // Merchant debug: simulate a client tapping « Demander un passage » on vitrine.
    function activeValidationMerchantSimulateCreateValid(uid) {
      let r = request.resource.data;
      return activeValidationSessionPayloadValid()
        && r.client_uid == uid
        && r.client_uid != request.auth.uid;
    }

    function clientResetActiveValidation() {
      // Allow the client to overwrite a previous completed/cancelled doc with
      // a fresh 'awaiting' session (handles the case where the merchant hasn't
      // deleted the doc yet but the client wants to start again).
      return (resource.data.status == 'completed' || resource.data.status == 'cancelled')
        && activeValidationCreateValid();
    }

    function clientCancelActiveValidation() {
      return resource.data.status == 'awaiting'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancel_reason']);
    }

    match /merchants/{merchantId}/active_validations/{clientUid} {
      allow read: if isSignedIn()
        && (request.auth.uid == clientUid || isMerchantOwner(merchantId));
      allow create: if isSignedIn()
        && (
          (request.auth.uid == clientUid && activeValidationCreateValid())
          || (isMerchantOwner(merchantId)
              && activeValidationMerchantSimulateCreateValid(clientUid))
        );
      allow update: if isMerchantOwner(merchantId)
        || (isSignedIn() && request.auth.uid == clientUid
            && (clientResetActiveValidation() || clientCancelActiveValidation()));
      allow delete: if isMerchantOwner(merchantId)
        || (isSignedIn() && request.auth.uid == clientUid);
    }

    match /merchants/{merchantId}/promotions/{promoId} {
      allow read: if true;
      allow create, update, delete: if isMerchantOwner(merchantId);
      // Any signed-in user (client viewing a storefront) may increment view_count only.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['view_count']);
    }

    // --- /merchants/{merchantId}/pending_clients/{clientId} ---
    // Written by the client when they follow (so the merchant sees new followers).
    // Merchant reads and deletes (acknowledge). Client can also delete (unfollow cleanup).
    match /merchants/{merchantId}/pending_clients/{clientId} {
      allow read, delete: if isMerchantOwner(merchantId);
      allow create, update: if isSignedIn() && request.auth.uid == clientId;
      allow delete: if isSignedIn() && request.auth.uid == clientId;
    }

    // --- /merchants/{merchantId}/partners/{partnerId} ---
    // Public read (visible on storefront); merchant owner can write.
    match /merchants/{merchantId}/partners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if isMerchantOwner(merchantId);
    }

    // --- /merchants/{merchantId}/clients/{clientId} ---
    // Merchant-side per-client overrides (manual segment tag, notes, etc.).
    // Owned by the merchant — only the merchant can read or write.
    match /merchants/{merchantId}/clients/{clientId} {
      allow read, create, update, delete: if isMerchantOwner(merchantId);
    }

    match /merchants/{merchantId}/auto_notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isMerchantOwner(merchantId);
    }

    match /merchants/{merchantId}/sent_notifications/{notificationId} {
      allow read: if isMerchantOwner(merchantId);
      // Written by the app (merchant sending a quick notification).
      allow create: if isMerchantOwner(merchantId);
      allow update, delete: if false;
    }

    // --- /merchants/{merchantId}/scheduled_notifications/{scheduledId} ---
    // Scheduled manual notifications. The CF (`processScheduledNotifications`,
    // running every 5 minutes Europe/Paris) flips status from 'pending'
    // to 'sent' / 'failed' and writes sent_at + sent_count. The merchant
    // can only:
    //   - create with status: 'pending' and the schema-allowed fields;
    //   - update solely to flip status to 'cancelled' (no other field
    //     change permitted; CF-only fields untouchable).
    // Reads owner-only. Deletes allowed (owner cleanup).
    match /merchants/{merchantId}/scheduled_notifications/{scheduledId} {
      allow read, delete: if isMerchantOwner(merchantId);
      allow create: if isMerchantOwner(merchantId)
        && request.resource.data.keys().hasOnly(
          ['text', 'audience', 'segments', 'scheduled_at', 'status',
           'created_at', 'created_by_uid']
        )
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.audience in [
          'Tous mes clients', 'Certains clients'
        ]
        && request.resource.data.segments is list
        && request.resource.data.scheduled_at is timestamp
        && request.resource.data.status == 'pending'
        && request.resource.data.created_by_uid == request.auth.uid;
      // The cancel path: owner can ONLY change status (and only to
      // 'cancelled'). CF-only fields (sent_at, sent_count,
      // failure_reason) and the original payload remain locked.
      allow update: if isMerchantOwner(merchantId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status'])
        && request.resource.data.status == 'cancelled'
        && resource.data.status == 'pending';
    }

    // --- /merchants/{merchantId}/notification_templates/{templateId} ---
    // Merchant-owned saved templates for the manual notification flow.
    // Schema gate keeps the wire shape narrow so a future migration can
    // rely on the documented field set:
    //   name, text, audience, segments, created_at, updated_at.
    // Length caps mirror the client-side validator (firestore_notification_
    // template_repository.dart) — 80 chars for name, 500 for text — so a
    // bypass via the REST API gets the same rejection.
    match /merchants/{merchantId}/notification_templates/{templateId} {
      allow read: if isMerchantOwner(merchantId);
      allow create, update: if isMerchantOwner(merchantId)
        && request.resource.data.keys().hasOnly(
          ['name', 'text', 'audience', 'segments', 'created_at', 'updated_at']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.audience in [
          'Tous mes clients', 'Certains clients'
        ]
        && request.resource.data.segments is list;
      allow delete: if isMerchantOwner(merchantId);
    }

    // --- /reports/{reportId} ---
    // App Store guideline 1.2: any app with user-generated content needs a
    // reporting mechanism. Writes are append-only by signed-in users; the
    // collection is intentionally NOT readable from the client (admins
    // review via Firebase Console with the Admin SDK).
    //
    // Schema gate enforced server-side so a malicious user can't flood the
    // collection with arbitrary fields:
    //   - reporter_uid must equal the auth uid (no spoofing)
    //   - target_type must be one of a small allowlist
    //   - reason must be in an allowlist (UI restricts the picker)
    //   - message is optional, capped at 500 chars
    //   - created_at must be a server timestamp
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if isSignedIn()
        && request.resource.data.reporter_uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'reporter_uid', 'target_type', 'target_id',
          'reason', 'message', 'created_at'
        ])
        && request.resource.data.target_type is string
        && request.resource.data.target_type in [
          'merchant', 'promotion', 'notification', 'user'
        ]
        && request.resource.data.target_id is string
        && request.resource.data.target_id.size() > 0
        && request.resource.data.target_id.size() <= 128
        && request.resource.data.reason is string
        && request.resource.data.reason in [
          'spam', 'harassment', 'inappropriate', 'fraud',
          'fake_business', 'other'
        ]
        && (!('message' in request.resource.data)
          || (request.resource.data.message is string
            && request.resource.data.message.size() <= 500))
        && request.resource.data.created_at is timestamp;
    }
  }
}
