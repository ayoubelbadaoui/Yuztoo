rules_version = '2';

// Yuztoo — aligned with lib/ Firestore usage (users, merchants, subcollections).
//
// Deploy: firebase deploy --only firestore:rules
// Local validation: cd tools/firebase && npm install && npm run rules:emulator
//   (rules load when Firestore Emulator starts; use project demo-* without login.)
// Review in console before production — this replaces existing rules for matched paths.
//
// Notes:
// - users: collection list/get-all is DENIED. The follower-count helper that scans
//   collection('users') will get permission-denied; the app already treats that as non-fatal.
// - users.status: clients cannot change an existing value (e.g. unblock after admin block).
//   First-time create may set status to "active" only (or omit status).
// - merchants: public read for discovery / storefront; writes only for owner_uid.
// - Subcollections under merchants: owner-only via parent merchant document.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function rolesShapeValid() {
      return ('roles' in request.resource.data)
        && request.resource.data.roles.keys().hasOnly(['client', 'merchant', 'provider'])
        && request.resource.data.roles.client is bool
        && request.resource.data.roles.merchant is bool
        && request.resource.data.roles.provider is bool;
    }

    function noLegacyDottedRoleKeys() {
      return !request.resource.data.keys().hasAny([
        'roles.client',
        'roles.merchant',
        'roles.provider'
      ]);
    }

    // --- Admin CRM ownership ---------------------------------------------
    // Fields written exclusively by the back-office callables (Admin SDK,
    // which bypasses these rules). Clients must never create or modify them:
    // clearing `deleted_at` would let a soft-deleted account un-delete itself
    // before the retention sweep, and forging it would let anyone queue an
    // arbitrary document for permanent deletion.
    function adminOwnedFields() {
      return [
        'deleted_at',
        'deleted_by',
        'deleted_reason',
        'deleted_via',
        'status_before_delete',
        'created_by_admin'
      ];
    }

    function noAdminOwnedFieldsOnCreate() {
      return !request.resource.data.keys().hasAny(adminOwnedFields());
    }

    function noAdminOwnedFieldChanges() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(adminOwnedFields());
    }

    // A soft-deleted document is frozen to the client SDK until an admin
    // restores it (or the sweep removes it for good).
    function notSoftDeleted() {
      return resource.data.get('deleted_at', null) == null;
    }

    // --- /admin_audit_log/{entryId} ---------------------------------------
    // Immutable record of every back-office action. Written only by the
    // Admin SDK and read only through the Firebase Console — never exposed
    // to any client, including admins' browsers, which see it (if at all)
    // through a callable.
    match /admin_audit_log/{entryId} {
      allow read, create, update, delete: if false;
    }

    function onboardingShapeValid() {
      let o = request.resource.data.onboarding;
      return ('onboarding' in request.resource.data)
        && o is map
        && o.keys().hasOnly(['merchant', 'client'])
        && (!('merchant' in o)
          || (o.merchant is string && o.merchant in ['not_started', 'completed']))
        && (!('client' in o)
          || (o.client is string && o.client in ['not_started', 'completed']));
    }

    // --- /phone_index/{phone} --- E.164 id (same string as users.phone); blocks duplicate phones across UIDs.
    // Unauthenticated get: signup checks existence via transaction.get (evaluated as [get], not [list]).
    // Keep list denied so the collection cannot be enumerated (plain doc.get on some clients uses list).
    match /phone_index/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/phone_index/$(phone));
      allow update: if false;
      allow delete: if false;
    }

    // --- /email_index/{email} --- Lowercased email as doc id; blocks duplicate emails across roles (client/merchant).
    // Same pattern as phone_index: public get so signup can check existence before OTP; list denied.
    match /email_index/{email} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/email_index/$(email));
      allow update: if false;
      allow delete: if false;
    }

    // --- /users/{userId} -------------------------------------------------
    // Block self-service status changes once set; allow first write to "active" (or omit).
    // (Keep conditions inline: resource/request are match-scoped.)
    match /users/{userId} {
      // Merchant CRM: allow a signed-in merchant to read a client's profile only
      // if that client follows them (exists users/{userId}/followed_merchants/{auth.uid}).
      allow get: if isOwner(userId)
        || (isSignedIn() && exists(/databases/$(database)/documents/users/$(userId)/followed_merchants/$(request.auth.uid)));
      allow list: if false;

      allow create: if isOwner(userId) && (
        !('status' in request.resource.data) || request.resource.data.status == 'active'
      ) && onboardingShapeValid() && rolesShapeValid() && noLegacyDottedRoleKeys()
        && noAdminOwnedFieldsOnCreate();

      allow update: if isOwner(userId) && (
        !('status' in resource.data)
          ? (!('status' in request.resource.data) || request.resource.data.status == 'active')
          : resource.data.status == request.resource.data.status
      ) && onboardingShapeValid() && rolesShapeValid() && noLegacyDottedRoleKeys()
        && noAdminOwnedFieldChanges();

      allow delete: if false;
    }

    match /users/{userId}/followed_merchants/{merchantId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // --- /users/{userId}/blocked_merchants/{merchantId} ---
    // Per-user blocklist of merchants the user no longer wishes to receive
    // notifications from or see in their carnet/recommendations. Strictly
    // private to the owning user — merchants must NOT learn they were blocked
    // (App Store guideline 1.2: blocking should be silent and one-sided).
    // Cloud Functions read this via collection-group; the rule below allows
    // owner-only read/write at the per-doc path. Writes are constrained to
    // an empty / `created_at`-only payload to minimise data exposure.
    match /users/{userId}/blocked_merchants/{merchantId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['created_at'])
        && (
          !('created_at' in request.resource.data)
          || request.resource.data.created_at is timestamp
        );
    }

    // Collection-group rule: lets a signed-in merchant read all followed_merchants
    // docs where merchant_id == their own UID (used by getFollowerIds query).
    // Also allows the merchant OWNER to read even when merchantId != authUid
    // (e.g. merchants created via linkExistingMerchantToUser).
    // Requires a composite index on collection-group followed_merchants / merchant_id.
    match /{path=**}/followed_merchants/{docId} {
      allow read: if isSignedIn()
        && (resource.data.merchant_id == request.auth.uid
          || (exists(/databases/$(database)/documents/merchants/$(resource.data.merchant_id))
            && get(/databases/$(database)/documents/merchants/$(resource.data.merchant_id)).data.owner_uid == request.auth.uid)
          || canManageStore(resource.data.merchant_id));
    }

    // --- /users/{userId}/loyalty_bons/{bonId} ---
    // Per-client persisted reward bons. Issued by Cloud Functions when a
    // welcome bon is unlocked (first visit) or a milestone threshold is
    // crossed; carry an optional `valid_until_at` so the scheduled
    // expiration CF can warn the client and mark expired ones. Strictly
    // server-written: clients read but never create/update. The
    // redemption mark (redeemed_at) is set server-side too — when the
    // merchant decrements validated_passages or the client claims the
    // welcome bon, the corresponding loyalty_clients write fires
    // onLoyaltyProgressUpdated which mirrors the change here.
    match /users/{userId}/loyalty_bons/{bonId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // --- /users/{userId}/notifications/{notificationId} ---
    // Clients read and mark their own notifications.
    // Merchant-originated creates must claim a merchant_id the caller actually owns.
    // This prevents any signed-in user from injecting fake notifications that
    // impersonate another merchant's name/id (cross-promotion / spam attack).
    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isSignedIn()
        && (
          // Self-inbox: a user may always write a notification to their OWN
          // inbox (e.g. an automatic loyalty passage recorded client-side on
          // scan). Safe because reads are owner-only and you cannot target
          // another user's inbox — at worst you notify yourself.
          isOwner(userId)
          // No merchant_id field (or empty string): system/legacy path — permitted.
          || !('merchant_id' in request.resource.data)
          || request.resource.data.merchant_id == ''
          // Merchant-originated: the caller must own the referenced merchant.
          || canManageStore(request.resource.data.merchant_id)
        );
    }

    // --- /users/{userId}/push_tokens/{tokenId} ---
    // Device FCM tokens: owner read/write only.
    match /users/{userId}/push_tokens/{tokenId} {
      allow read, write: if isOwner(userId);
    }

    // --- /merchants/{merchantId} -----------------------------------------
    function isMerchantOwner(merchantId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/merchants/$(merchantId))
        && get(/databases/$(database)/documents/merchants/$(merchantId)).data.owner_uid == request.auth.uid;
    }

    // --- Enseignes (multi-store) ------------------------------------------
    // A store joins an enseigne through `merchants/{id}.organization_id`.
    // Team access lives in `organizations/{orgId}/members/{uid}`:
    //   role: 'owner' | 'manager' | 'employee', status: 'active' | …,
    //   store_ids: stores the member works in (ignored for 'owner').
    // Stores without `organization_id` never reach the member lookup, so
    // single-store merchants keep exactly the owner-only behaviour.
    function orgPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function orgMemberPath(orgId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(uid);
    }

    function isOrgOwner(orgId) {
      return isSignedIn()
        && orgId is string
        && exists(orgPath(orgId))
        && get(orgPath(orgId)).data.owner_uid == request.auth.uid;
    }

    function activeOrgMember(orgId) {
      return isSignedIn()
        && exists(orgMemberPath(orgId, request.auth.uid))
        && get(orgMemberPath(orgId, request.auth.uid)).data.status == 'active';
    }

    function memberHasStoreRole(orgId, merchantId, roles) {
      let m = get(orgMemberPath(orgId, request.auth.uid)).data;
      return m.role in roles
        && (m.role == 'owner' || merchantId in m.get('store_ids', []));
    }

    function storeOrgId(merchantId) {
      return get(/databases/$(database)/documents/merchants/$(merchantId))
        .data.get('organization_id', null);
    }

    function hasStoreRole(merchantId, roles) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/merchants/$(merchantId))
        && storeOrgId(merchantId) is string
        && activeOrgMember(storeOrgId(merchantId))
        && memberHasStoreRole(storeOrgId(merchantId), merchantId, roles);
    }

    // Owner or gérant: vitrine, promotions, notifications, CRM.
    function canManageStore(merchantId) {
      return isMerchantOwner(merchantId)
        || hasStoreRole(merchantId, ['owner', 'manager']);
    }

    // Anyone on the store team, employees included: passages and bons.
    function canOperateStore(merchantId) {
      return isMerchantOwner(merchantId)
        || hasStoreRole(merchantId, ['owner', 'manager', 'employee']);
    }

    // State after the current batch — lets the enseigne, its first store and
    // the owner's membership be created in one atomic write.
    function isOrgOwnerAfter(orgId) {
      return isSignedIn()
        && orgId is string
        && existsAfter(orgPath(orgId))
        && getAfter(orgPath(orgId)).data.owner_uid == request.auth.uid;
    }

    // Moving a store into an enseigne requires owning that enseigne.
    function organizationLinkValid() {
      let next = request.resource.data.get('organization_id', null);
      let prev = resource == null ? null : resource.data.get('organization_id', null);
      return next == prev || next == null || isOrgOwnerAfter(next);
    }

    match /merchants/{merchantId} {
      // Discovery / vitrine: unauthenticated read OK for this app.
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && noAdminOwnedFieldsOnCreate()
        && organizationLinkValid();

      // `notSoftDeleted` is what makes an admin soft delete stick: without it
      // the owner could simply flip `status` back to 'active' from their own
      // vitrine and reappear in Découvrir.
      allow update: if isSignedIn()
        && resource.data.owner_uid == request.auth.uid
        && request.resource.data.owner_uid == resource.data.owner_uid
        && notSoftDeleted()
        && noAdminOwnedFieldChanges()
        && organizationLinkValid();

      // Gérant of this store: same edits as the owner, except ownership,
      // enseigne link and billing tier.
      allow update: if hasStoreRole(merchantId, ['owner', 'manager'])
        && request.resource.data.owner_uid == resource.data.owner_uid
        && notSoftDeleted()
        && noAdminOwnedFieldChanges()
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['organization_id', 'subscription_plan']);

      // Any signed-in user (e.g. a client following the merchant) may increment
      // only the monthly connected-clients counter fields. The diff() check ensures
      // no other field is touched.
      allow update: if isSignedIn()
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rappels_monthly_connected_clients', 'rappels_monthly_connected_ym']);

      // Any signed-in user (client completing a passage) may increment only the
      // validated-passage counter fields.
      allow update: if isSignedIn()
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rappels_monthly_validated_passages', 'rappels_monthly_validated_ym']);

      allow delete: if false;
    }

    // --- /merchants/{merchantId}/loyalty_clients/{userId} ---
    // Client: read own row; create/update with bounded increments (MVP — abuse limits only in rules).
    // Merchant owner: full read/write (validation manuelle, ajustements).
    function loyaltyClientDocKeys() {
      // first_visit_at is written on the very first passage and must be
      // included in the allowed set so that doc creation (which uses merge)
      // is not rejected.  All other keys remain unchanged after creation.
      // last_passage_at is the cooldown anchor — server timestamp written by
      // the client SDK on every additive passage; immutable to monotonic time.
      // welcome_bon_claimed_at is a one-shot timestamp written by the client
      // when they redeem the welcome bon. Once set it must never be cleared.
      return request.resource.data.keys().hasOnly([
        'validated_passages',
        'pending_passages',
        'cumulative_spend_euros',
        'updated_at',
        'first_visit_at',
        'last_passage_at',
        'welcome_bon_claimed_at',
        'enrolled_loyalty_program',
        'enrolled_at',
        'program_status'
      ]);
    }

    // Merchant-side create: the merchant validates a client's first passage
    // and the loyalty_clients doc is born from that synchronous write. The
    // legacy client-side create path (writing pending_passages = 1) is gone —
    // there is no pending state anymore. Pending sessions live in the
    // `active_validations` subcollection until the merchant submits the form.
    function loyaltyClientMerchantCreateValid() {
      let r = request.resource.data;
      return loyaltyClientDocKeys()
        && r.validated_passages is int
        && r.cumulative_spend_euros is number
        && r.updated_at is timestamp
        && r.validated_passages >= 0
        && r.cumulative_spend_euros >= 0
        && (!r.keys().hasAll(['first_visit_at']) || r.first_visit_at is timestamp)
        && (!r.keys().hasAll(['last_passage_at']) || r.last_passage_at is timestamp);
    }

    // Client self-update: the only mutation a client can make to their own
    // loyalty_clients doc is to claim the welcome bon (one-shot
    // welcome_bon_claimed_at: null → server timestamp). Every counter is
    // merchant-only — the client no longer writes pending_passages or any
    // passage delta; that responsibility moved to the merchant on validation.
    function loyaltyClientSelfUpdateValid() {
      let r = request.resource.data;
      let o = resource.data;
      return loyaltyClientDocKeys()
        && r.validated_passages == o.validated_passages
        // Legacy `pending_passages` may persist on old docs — tolerate it but
        // forbid client-side mutation.
        && (!r.keys().hasAll(['pending_passages'])
            || r.pending_passages == o.get('pending_passages', 0))
        && r.cumulative_spend_euros == o.cumulative_spend_euros
        // first_visit_at, last_passage_at, enrolled_* are merchant-managed.
        && (!r.keys().hasAll(['first_visit_at'])
            || r.first_visit_at == o.get('first_visit_at', null))
        && (!r.keys().hasAll(['last_passage_at'])
            || r.last_passage_at == o.get('last_passage_at', null))
        && (
          !r.keys().hasAll(['welcome_bon_claimed_at'])
          || (
            o.get('welcome_bon_claimed_at', null) == null
              && r.welcome_bon_claimed_at is timestamp
          )
          || r.welcome_bon_claimed_at == o.get('welcome_bon_claimed_at', null)
        )
        && (!r.keys().hasAll(['enrolled_loyalty_program'])
            || r.enrolled_loyalty_program == o.get('enrolled_loyalty_program', null))
        && (!r.keys().hasAll(['enrolled_at'])
            || r.enrolled_at == o.get('enrolled_at', null))
        && (!r.keys().hasAll(['program_status'])
            || r.program_status == o.get('program_status', null));
    }

    // Server-side cooldown enforcement — defence-in-depth alongside the
    // SDK-level check in [FirestoreClientLoyaltyRepository]. Skipped when
    // `merchants/{merchantId}.passage_cooldown_enabled == false`.
    function merchantPassageCooldownEnabled(merchantId) {
      let m = get(/databases/$(database)/documents/merchants/$(merchantId)).data;
      return m.get('passage_cooldown_enabled', true) != false;
    }

    function loyaltyClientPassageCooldownPasses(merchantId) {
      let r = request.resource.data;
      let o = resource.data;
      return !merchantPassageCooldownEnabled(merchantId)
        || o.get('last_passage_at', null) == null
        || r.get('last_passage_at', null) == o.last_passage_at
        || request.time >= o.last_passage_at + duration.value(1, 'h');
    }

    match /merchants/{merchantId}/loyalty_clients/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || canOperateStore(merchantId));

      // Only the merchant can create — the doc is born on first validation.
      allow create: if canOperateStore(merchantId)
        && loyaltyClientMerchantCreateValid();

      allow update: if (canOperateStore(merchantId)
          && loyaltyClientPassageCooldownPasses(merchantId))
        || (isSignedIn()
          && request.auth.uid == userId
          && loyaltyClientSelfUpdateValid());

      // Loyalty history is permanent: once a client earns passages,
      // that record must never be wiped from the client SDK. Any cleanup
      // (e.g. program reset) must go through a privileged Cloud Function
      // (Admin SDK) which bypasses security rules.
      allow delete: if false;
    }

    // --- /merchants/{merchantId}/active_validations/{clientUid} ---
    // Live "passage validation" sessions. The client taps "Demander un passage"
    // on the merchant's vitrine → this doc is created with status='awaiting'.
    // The merchant's app listens on the merchant-scoped collection and pops a
    // smart per-program form. On submit the merchant flips status to
    // 'completed' (and writes the deltas to loyalty_clients). On dismiss,
    // 'cancelled'. The doc id is the client's uid, so a re-tap overwrites a
    // stale completed/cancelled session.
    function activeValidationSessionPayloadValid() {
      let r = request.resource.data;
      return r.keys().hasAll(['client_uid', 'client_display_name', 'created_at', 'status', 'program_snapshot'])
        && r.client_display_name is string
        && r.status == 'awaiting'
        && r.created_at is timestamp
        && r.program_snapshot is map
        && (!r.keys().hasAll(['client_photo_url']) || r.client_photo_url is string)
        && (!r.keys().hasAll(['source']) || r.source in ['vitrine', 'ble'])
        && (!r.keys().hasAll(['client_ble_connected_at']) || r.client_ble_connected_at is timestamp)
        && (!r.keys().hasAll(['merchant_ble_connected_at']) || r.merchant_ble_connected_at is timestamp)
        && (!r.keys().hasAll(['merchant_display_name']) || r.merchant_display_name is string);
    }

    function activeValidationCreateKeysValid() {
      let r = request.resource.data;
      return r.keys().hasOnly([
            'client_uid', 'client_display_name', 'client_photo_url',
            'created_at', 'status', 'program_snapshot',
            'source', 'client_ble_connected_at', 'merchant_display_name'
          ]);
    }

    function activeValidationBleCreateValid() {
      let r = request.resource.data;
      return activeValidationSessionPayloadValid()
        && activeValidationCreateKeysValid()
        && r.source == 'ble'
        && r.keys().hasAll(['client_ble_connected_at']);
    }

    function activeValidationVitrineCreateValid() {
      let r = request.resource.data;
      return activeValidationSessionPayloadValid()
        && r.keys().hasOnly([
            'client_uid', 'client_display_name', 'client_photo_url',
            'created_at', 'status', 'program_snapshot'
          ]);
    }

    function activeValidationCreateValid() {
      let r = request.resource.data;
      return r.client_uid == request.auth.uid
        && (activeValidationVitrineCreateValid() || activeValidationBleCreateValid());
    }

    // Merchant debug: simulate vitrine request (no BLE fields).
    function activeValidationMerchantSimulateVitrineCreateValid(uid) {
      let r = request.resource.data;
      return activeValidationVitrineCreateValid()
        && r.client_uid == uid
        && r.client_uid != request.auth.uid;
    }

    // Merchant debug: simulate client BLE connection (source=ble + timestamps).
    function activeValidationMerchantSimulateBleCreateValid(uid) {
      let r = request.resource.data;
      return activeValidationBleCreateValid()
        && r.client_uid == uid
        && r.client_uid != request.auth.uid;
    }

    function clientResetActiveValidation() {
      // Allow the client to overwrite a previous completed/cancelled doc with
      // a fresh 'awaiting' session (handles the case where the merchant hasn't
      // deleted the doc yet but the client wants to start again).
      return (resource.data.status == 'completed' || resource.data.status == 'cancelled')
        && activeValidationCreateValid();
    }

    function clientCancelActiveValidation() {
      return resource.data.status == 'awaiting'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancel_reason']);
    }

    // BLE sessions must be accepted on the merchant device before completion.
    function activeValidationBleCompleteAllowed() {
      return !resource.data.keys().hasAll(['source'])
        || resource.data.source != 'ble'
        || resource.data.keys().hasAll(['merchant_ble_connected_at']);
    }

    function merchantMarkBleConnectedValid() {
      return resource.data.status == 'awaiting'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['merchant_ble_connected_at'])
        && request.resource.data.merchant_ble_connected_at is timestamp;
    }

    function merchantMarkOpenedValid() {
      return resource.data.status == 'awaiting'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['opened_at'])
        && request.resource.data.opened_at is timestamp;
    }

    function merchantCompleteActiveValidationValid() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.status == 'awaiting'
        && request.resource.data.status == 'completed'
        && request.resource.data.completed_at is timestamp
        && diff.hasOnly([
              'status', 'completed_at', 'result_validated_delta',
              'result_spend_delta', 'declared_spend_euros'
            ])
        && activeValidationBleCompleteAllowed();
    }

    function merchantCancelActiveValidationValid() {
      let r = request.resource.data;
      return resource.data.status == 'awaiting'
        && r.status == 'cancelled'
        && r.keys().hasAll(['cancel_reason', 'completed_at'])
        && r.cancel_reason is string
        && r.completed_at is timestamp
        && r.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancel_reason', 'completed_at']);
    }

    function merchantActiveValidationUpdateValid() {
      let r = request.resource.data;
      return merchantMarkBleConnectedValid()
        || merchantMarkOpenedValid()
        || (r.status == 'completed' && merchantCompleteActiveValidationValid())
        || (r.status == 'cancelled' && merchantCancelActiveValidationValid());
    }

    function activeValidationMerchantOwnerSelfBleBlocked(merchantId, clientUid) {
      let r = request.resource.data;
      return !(isMerchantOwner(merchantId)
        && request.auth.uid == clientUid
        && r.keys().hasAll(['source'])
        && r.source == 'ble');
    }

    match /merchants/{merchantId}/active_validations/{clientUid} {
      allow read: if isSignedIn()
        && (request.auth.uid == clientUid || canOperateStore(merchantId));
      allow create: if isSignedIn()
        && activeValidationMerchantOwnerSelfBleBlocked(merchantId, clientUid)
        && (
          (request.auth.uid == clientUid && activeValidationCreateValid())
          || (isMerchantOwner(merchantId)
              && activeValidationMerchantSimulateVitrineCreateValid(clientUid))
          || (isMerchantOwner(merchantId)
              && activeValidationMerchantSimulateBleCreateValid(clientUid))
        );
      allow update: if (canOperateStore(merchantId)
            && merchantActiveValidationUpdateValid())
        || (isSignedIn() && request.auth.uid == clientUid
            && (clientResetActiveValidation() || clientCancelActiveValidation()));
      allow delete: if canOperateStore(merchantId)
        || (isSignedIn() && request.auth.uid == clientUid);
    }

    match /merchants/{merchantId}/promotions/{promoId} {
      allow read: if true;
      allow create, update, delete: if canManageStore(merchantId);
      // Any signed-in user (client viewing a storefront) may increment view_count only.
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['view_count']);
    }

    // --- /merchants/{merchantId}/profile_views/{viewId} ---
    //
    // Per-(merchant, viewer, UTC day) marker doc, written by the client
    // app when a signed-in user opens the storefront. Used to count
    // distinct profile views over a 7-day sliding window for the
    // merchant dashboard ("VUES / SEMAINE" KPI).
    //
    // Document id is "{YYYY-MM-DD}_{viewerUid}" — both the date prefix
    // and the trailing uid are validated against the payload + auth so a
    // viewer cannot impersonate someone else or manipulate the date
    // field to inflate or deflate counters.
    //
    // Reads: merchant-only (the viewer-uid list is private analytics).
    // Writes: signed-in viewer can create/update only their own marker
    //         for the current day, with a strict shape; merchant owner
    //         can clean up.
    // Helper functions live OUTSIDE the `match` block: in Firestore
    // Rules, functions defined at this scope cannot capture path
    // variables from a `match` block (they evaluate to `null` and the
    // whole rule errors out). All path bindings must therefore be
    // passed in as arguments — same pattern as `isMerchantOwner`.
    function profileViewWriteValid(merchantId, viewId) {
      let r = request.resource.data;
      return isSignedIn()
        && r.viewer_uid == request.auth.uid
        // Block the merchant owner from inflating their own dashboard
        // by previewing their own vitrine. `isMerchantOwner` resolves
        // the storefront's `owner_uid` and compares against
        // `request.auth.uid`, which is the only reliable identity here
        // (the doc id `merchantId` is rarely equal to the owner's uid).
        && !isMerchantOwner(merchantId)
        // Date string must be 'YYYY-MM-DD' and match the doc id prefix.
        && r.date is string
        && r.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && viewId == r.date + '_' + r.viewer_uid
        // Tight shape — no piggy-backed fields can sneak in.
        && r.keys().hasOnly(['date', 'viewer_uid', 'updated_at']);
    }

    match /merchants/{merchantId}/profile_views/{viewId} {
      allow read: if canManageStore(merchantId);
      allow create, update: if profileViewWriteValid(merchantId, viewId);
      allow delete: if canManageStore(merchantId);
    }

    // --- Actualité photo engagement (likes / views) -----------------------
    //
    // merchants/{id}/news_photo_stats/{photoId}  → public counters shown on
    //   the gallery tiles (merchant dashboard + client vitrine).
    // merchants/{id}/news_photo_views/{photoId}_{uid} → one marker per
    //   (photo, viewer) so a view is only ever counted once.
    // merchants/{id}/news_photo_likes/{photoId}_{uid} → like marker; its
    //   existence is the client's "liked by me" heart state.
    //
    // Counters are written client-side with FieldValue.increment inside a
    // transaction, so the rules bound each write to a ±1 step and a fixed
    // shape: a client can like/unlike or add one view, never jump a counter
    // to an arbitrary value. Marker doc ids embed the writer's uid, which
    // is validated against auth so nobody can act for another account.
    function newsPhotoCountDeltaValid(key, minDelta, maxDelta) {
      let prev = resource == null ? 0 : resource.data.get(key, 0);
      let next = request.resource.data.get(key, 0);
      return next is int
        && next >= 0
        && next >= prev + minDelta
        && next <= prev + maxDelta;
    }

    function newsPhotoStatsWriteValid() {
      let r = request.resource.data;
      return isSignedIn()
        && r.keys().hasOnly(['image_url', 'likes_count', 'views_count', 'updated_at'])
        && r.image_url is string
        && newsPhotoCountDeltaValid('likes_count', -1, 1)
        && newsPhotoCountDeltaValid('views_count', 0, 1);
    }

    function newsPhotoMarkerWriteValid(markerId, requiredKeys) {
      let r = request.resource.data;
      return isSignedIn()
        && r.viewer_uid == request.auth.uid
        && markerId == r.photo_id + '_' + r.viewer_uid
        && r.photo_id is string
        && r.keys().hasOnly(requiredKeys);
    }

    // Marker reads must also succeed for documents that do not exist yet
    // (that is exactly how "not liked" is detected), so the check is on the
    // doc id suffix rather than on `resource.data`, which is null then.
    function ownsNewsPhotoMarker(markerId) {
      return isSignedIn() && markerId.matches('.*_' + request.auth.uid);
    }

    match /merchants/{merchantId}/news_photo_stats/{photoId} {
      allow read: if true;
      allow create, update: if canManageStore(merchantId)
        || newsPhotoStatsWriteValid();
      allow delete: if canManageStore(merchantId);
    }

    match /merchants/{merchantId}/news_photo_views/{markerId} {
      allow read: if canManageStore(merchantId) || ownsNewsPhotoMarker(markerId);
      allow create, update: if newsPhotoMarkerWriteValid(
        markerId, ['photo_id', 'viewer_uid', 'updated_at']);
      allow delete: if canManageStore(merchantId) || ownsNewsPhotoMarker(markerId);
    }

    match /merchants/{merchantId}/news_photo_likes/{markerId} {
      allow read: if canManageStore(merchantId) || ownsNewsPhotoMarker(markerId);
      allow create, update: if newsPhotoMarkerWriteValid(
        markerId, ['photo_id', 'viewer_uid', 'created_at']);
      allow delete: if canManageStore(merchantId) || ownsNewsPhotoMarker(markerId);
    }

    // --- Promotion likes (client heart on offers) ---------------------------
    // Same ±1 counter / marker pattern as news_photo_* engagement.
    function promotionStatsWriteValid() {
      let r = request.resource.data;
      return isSignedIn()
        && r.keys().hasOnly(['likes_count', 'updated_at'])
        && newsPhotoCountDeltaValid('likes_count', -1, 1);
    }

    function promotionLikeMarkerWriteValid(markerId) {
      let r = request.resource.data;
      return isSignedIn()
        && r.viewer_uid == request.auth.uid
        && markerId == r.promotion_id + '_' + r.viewer_uid
        && r.promotion_id is string
        && r.keys().hasOnly(['promotion_id', 'viewer_uid', 'created_at']);
    }

    function ownsPromotionLikeMarker(markerId) {
      return isSignedIn() && markerId.matches('.*_' + request.auth.uid);
    }

    match /merchants/{merchantId}/promotion_stats/{promoId} {
      allow read: if true;
      allow create, update: if canManageStore(merchantId)
        || promotionStatsWriteValid();
      allow delete: if canManageStore(merchantId);
    }

    match /merchants/{merchantId}/promotion_likes/{markerId} {
      allow read: if canManageStore(merchantId) || ownsPromotionLikeMarker(markerId);
      allow create, update: if promotionLikeMarkerWriteValid(markerId);
      allow delete: if canManageStore(merchantId) || ownsPromotionLikeMarker(markerId);
    }

    // --- /merchants/{merchantId}/pending_clients/{clientId} ---
    // Written by the client when they follow (so the merchant sees new followers).
    // Merchant reads and deletes (acknowledge). Client can also delete (unfollow cleanup).
    match /merchants/{merchantId}/pending_clients/{clientId} {
      allow read, delete: if canManageStore(merchantId);
      allow create, update: if isSignedIn() && request.auth.uid == clientId;
      allow delete: if isSignedIn() && request.auth.uid == clientId;
    }

    // --- /merchants/{merchantId}/partners/{partnerId} ---
    // Public read (visible on storefront); merchant owner can write.
    match /merchants/{merchantId}/partners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if canManageStore(merchantId);
    }

    // --- /merchants/{merchantId}/clients/{clientId} ---
    // Merchant-side per-client overrides (manual segment tag, notes, etc.).
    // Owned by the merchant — only the merchant can read or write.
    match /merchants/{merchantId}/clients/{clientId} {
      allow read, create, update, delete: if canManageStore(merchantId);
    }

    match /merchants/{merchantId}/auto_notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if canManageStore(merchantId);
    }

    match /merchants/{merchantId}/sent_notifications/{notificationId} {
      allow read: if canManageStore(merchantId);
      // Written by the app (merchant sending a quick notification).
      allow create: if canManageStore(merchantId);
      // Merchant owner may finalize sent_count after fan-out; clients may
      // increment open_count only (inbox read — mirrors promotion view_count).
      allow update: if (canManageStore(merchantId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['sent_count']))
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['open_count']));
      allow delete: if false;
    }

    // --- /merchants/{merchantId}/scheduled_notifications/{scheduledId} ---
    // Scheduled manual notifications. The CF (`processScheduledNotifications`,
    // running every 5 minutes Europe/Paris) flips status from 'pending'
    // to 'sent' / 'failed' and writes sent_at + sent_count. The merchant
    // can only:
    //   - create with status: 'pending' and the schema-allowed fields;
    //   - update solely to flip status to 'cancelled' (no other field
    //     change permitted; CF-only fields untouchable).
    // Reads owner-only. Deletes allowed (owner cleanup).
    match /merchants/{merchantId}/scheduled_notifications/{scheduledId} {
      allow read, delete: if canManageStore(merchantId);
      allow create: if canManageStore(merchantId)
        && request.resource.data.keys().hasOnly(
          ['text', 'audience', 'segments', 'scheduled_at', 'status',
           'created_at', 'created_by_uid']
        )
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.audience in [
          'Tous mes clients', 'Certains clients'
        ]
        && request.resource.data.segments is list
        && request.resource.data.scheduled_at is timestamp
        && request.resource.data.status == 'pending'
        && request.resource.data.created_by_uid == request.auth.uid;
      // The cancel path: owner can ONLY change status (and only to
      // 'cancelled'). CF-only fields (sent_at, sent_count,
      // failure_reason) and the original payload remain locked.
      allow update: if canManageStore(merchantId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status'])
        && request.resource.data.status == 'cancelled'
        && resource.data.status == 'pending';
    }

    // --- /merchants/{merchantId}/notification_templates/{templateId} ---
    // Merchant-owned saved templates for the manual notification flow.
    // Schema gate keeps the wire shape narrow so a future migration can
    // rely on the documented field set:
    //   name, text, audience, segments, created_at, updated_at.
    // Length caps mirror the client-side validator (firestore_notification_
    // template_repository.dart) — 80 chars for name, 500 for text — so a
    // bypass via the REST API gets the same rejection.
    match /merchants/{merchantId}/notification_templates/{templateId} {
      allow read: if canManageStore(merchantId);
      allow create, update: if canManageStore(merchantId)
        && request.resource.data.keys().hasOnly(
          ['name', 'text', 'audience', 'segments', 'created_at', 'updated_at']
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.audience in [
          'Tous mes clients', 'Certains clients'
        ]
        && request.resource.data.segments is list;
      allow delete: if canManageStore(merchantId);
    }

    // --- /organizations/{orgId} — enseignes (multi-store) ---------------
    // Public read: the enseigne page shows name / logo / description to
    // clients. Billing data must live in an owner-only subcollection.
    function organizationShapeValid() {
      let r = request.resource.data;
      return r.name is string
        && r.name.size() > 0
        && r.name.size() <= 80
        && r.owner_uid is string
        && r.loyalty_mode in ['per_store', 'shared'];
    }

    match /organizations/{orgId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && organizationShapeValid()
        && noAdminOwnedFieldsOnCreate();
      allow update: if isOrgOwner(orgId)
        && request.resource.data.owner_uid == resource.data.owner_uid
        && organizationShapeValid()
        && noAdminOwnedFieldChanges();
      allow delete: if false;
    }

    function myOrgMember(orgId) {
      return get(orgMemberPath(orgId, request.auth.uid)).data;
    }

    function isActiveOrgManager(orgId) {
      return activeOrgMember(orgId) && myOrgMember(orgId).role == 'manager';
    }

    // Gérants manage employees, only inside the stores they run themselves.
    function isActiveManagerOfStores(orgId, storeIds) {
      return isActiveOrgManager(orgId)
        && myOrgMember(orgId).get('store_ids', []).hasAll(storeIds);
    }

    function orgInvitePath(orgId, inviteId) {
      return /databases/$(database)/documents/organizations/$(orgId)/invites/$(inviteId);
    }

    function orgMemberShapeValid(orgId, uid) {
      let r = request.resource.data;
      return r.keys().hasOnly([
            'uid', 'org_id', 'role', 'store_ids', 'status', 'display_name',
            'invited_by', 'invite_id', 'joined_at', 'updated_at'
          ])
        && r.uid == uid
        && r.org_id == orgId
        && r.role in ['owner', 'manager', 'employee']
        && r.status in ['active', 'removed']
        && r.store_ids is list;
    }

    // Accepting an invite: the member doc must copy the invite's role and
    // stores, and the same batch must flip the invite to accepted by this
    // user, so one invite can never enrol several accounts.
    function orgInviteAcceptValid(orgId, uid) {
      let r = request.resource.data;
      return isSignedIn()
        && request.auth.uid == uid
        && r.invite_id is string
        && exists(orgInvitePath(orgId, r.invite_id))
        && get(orgInvitePath(orgId, r.invite_id)).data.status == 'pending'
        && get(orgInvitePath(orgId, r.invite_id)).data.expires_at > request.time
        && get(orgInvitePath(orgId, r.invite_id)).data.role == r.role
        && get(orgInvitePath(orgId, r.invite_id)).data.store_ids == r.store_ids
        && getAfter(orgInvitePath(orgId, r.invite_id)).data.status == 'accepted'
        && getAfter(orgInvitePath(orgId, r.invite_id)).data.accepted_by == uid
        && r.status == 'active';
    }

    match /organizations/{orgId}/members/{uid} {
      allow read: if isSignedIn()
        && (request.auth.uid == uid || isOrgOwner(orgId) || activeOrgMember(orgId));

      allow create: if orgMemberShapeValid(orgId, uid)
        && (
          (isOrgOwnerAfter(orgId)
            && (request.resource.data.role != 'owner' || uid == request.auth.uid))
          || (request.resource.data.role == 'employee'
            && isActiveManagerOfStores(orgId, request.resource.data.store_ids))
          || (request.resource.data.role != 'owner'
            && orgInviteAcceptValid(orgId, uid))
        );

      allow update: if orgMemberShapeValid(orgId, uid)
        && (
          // The owner can change anyone but cannot demote himself.
          (isOrgOwner(orgId)
            && (uid != request.auth.uid || request.resource.data.role == 'owner'))
          || (resource.data.role == 'employee'
            && request.resource.data.role == 'employee'
            && isActiveManagerOfStores(orgId, resource.data.store_ids)
            && isActiveManagerOfStores(orgId, request.resource.data.store_ids))
          // Anyone may leave the team.
          || (request.auth.uid == uid
            && resource.data.role != 'owner'
            && request.resource.data.status == 'removed'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updated_at']))
        );

      allow delete: if (isOrgOwner(orgId) && uid != request.auth.uid)
        || (resource.data.role == 'employee'
          && isActiveManagerOfStores(orgId, resource.data.store_ids));
    }

    // "Which enseignes am I in?" — collection-group query on my own docs.
    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function orgInviteShapeValid(orgId) {
      let r = request.resource.data;
      return r.keys().hasOnly([
            'org_id', 'org_name', 'role', 'store_ids', 'status', 'contact',
            'created_by', 'created_at', 'expires_at', 'accepted_by', 'accepted_at'
          ])
        && r.org_id == orgId
        && r.role in ['manager', 'employee']
        && r.store_ids is list
        && r.store_ids.size() > 0
        && r.expires_at is timestamp
        && r.created_by is string;
    }

    // The random invite id is the secret shared by link: anyone signed in
    // can open an invite by id, only the team can list them.
    match /organizations/{orgId}/invites/{inviteId} {
      allow get: if isSignedIn();
      allow list: if isOrgOwner(orgId) || isActiveOrgManager(orgId);

      allow create: if orgInviteShapeValid(orgId)
        && request.resource.data.status == 'pending'
        && request.resource.data.created_by == request.auth.uid
        && (isOrgOwner(orgId)
          || (request.resource.data.role == 'employee'
            && isActiveManagerOfStores(orgId, request.resource.data.store_ids)));

      allow update: if (
          isSignedIn()
          && resource.data.status == 'pending'
          && resource.data.expires_at > request.time
          && request.resource.data.status == 'accepted'
          && request.resource.data.accepted_by == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'accepted_by', 'accepted_at'])
        )
        || (
          (isOrgOwner(orgId) || resource.data.created_by == request.auth.uid)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'revoked'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status'])
        );

      allow delete: if isOrgOwner(orgId);
    }

    // --- /app_config/{docId} ---
    //
    // Remote product config. Clients may only read the force-update gate;
    // other docs (e.g. future media catalogs) stay closed until their own
    // rule is added. Writes are Admin SDK / CRM callables only.
    //
    // app_config/force_update
    //   force, android_min_build, ios_min_build, message_fr?,
    //   android_store_url?, ios_store_url?
    match /app_config/{docId} {
      allow read: if docId == 'force_update';
      allow write: if false;
    }

    // --- /yuztoo_news/{newsId} ---
    //
    // Editorial "Actu YuzToo" shown at the top of the client inbox. Authored
    // from the Sales CRM CMS (Admin callables / Admin SDK), never by the app.
    //
    // Release gate (per actu):
    //   draft   — unreadable to clients
    //   preview — only the selected test_account_id (signed-in)
    //   live    — public (legacy docs missing release_status ≡ live)
    //
    // Clients use dual queries (live + own preview) so other users' previews
    // never poison the live listener with permission-denied.
    //
    //   title / body / publish_on / active / image_url / cta_*
    //   release_status, test_account_id, test_account_label,
    //   preview_activated_at, live_at
    function yuztooNewsReleaseStatus() {
      return ('release_status' in resource.data)
        ? resource.data.release_status
        : 'live';
    }

    function canReadYuztooNews() {
      return yuztooNewsReleaseStatus() == 'live'
        || (
          yuztooNewsReleaseStatus() == 'preview'
          && isSignedIn()
          && resource.data.test_account_id == request.auth.uid
        );
    }

    match /yuztoo_news/{newsId} {
      allow read: if canReadYuztooNews();
      allow write: if false;
    }

    // --- Merchant associations ---------------------------------------------
    //
    // merchant_associations/{associationId}
    //   name, name_lowercase, city, description, founder_merchant_id,
    //   member_count, created_at, updated_at
    // merchant_associations/{associationId}/association_members/{merchantId}
    //   association_id, merchant_id, merchant_name, merchant_logo_url,
    //   merchant_city, status ('pending' | 'approved'), requested_at,
    //   approved_at
    //
    // Public read: clients browse the association page (association name +
    // every approved member shop) from a member's vitrine, exactly like the
    // vitrine itself, which is readable unauthenticated.
    function associationFounderId(associationId) {
      return get(/databases/$(database)/documents/merchant_associations/$(associationId))
        .data.founder_merchant_id;
    }

    function isAssociationFounder(associationId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/merchant_associations/$(associationId))
        && isMerchantOwner(associationFounderId(associationId));
    }

    match /merchant_associations/{associationId} {
      allow read: if true;

      // Only a merchant owner can found one, and only in their own name.
      allow create: if isSignedIn()
        && isMerchantOwner(request.resource.data.founder_merchant_id);

      // Founder edits the association itself. Any signed-in merchant may
      // touch `member_count` only, because joining / leaving keeps the
      // denormalized count in the same transaction as the member doc
      // (mirrors the `view_count` carve-out on promotions).
      allow update: if isAssociationFounder(associationId)
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['member_count', 'updated_at']));

      allow delete: if isAssociationFounder(associationId);
    }

    match /merchant_associations/{associationId}/association_members/{merchantId} {
      allow read: if true;

      // A merchant may only ever file its own membership, and only as
      // 'pending' — approval is the founder's call. The one exception is the
      // founder writing itself in as the first approved member: that happens
      // in the same batch as the association doc, so `exists()` here still
      // sees nothing and the founder check cannot be resolved yet.
      allow create: if isMerchantOwner(merchantId)
        && request.resource.data.merchant_id == merchantId
        && (
          request.resource.data.status == 'pending'
          || (request.resource.data.status == 'approved'
            && !exists(/databases/$(database)/documents/merchant_associations/$(associationId)))
          || (request.resource.data.status == 'approved'
            && associationFounderId(associationId) == merchantId)
        );

      allow update: if isAssociationFounder(associationId);

      // Founder removes a member / refuses a request; a merchant leaves or
      // cancels its own request.
      allow delete: if isAssociationFounder(associationId)
        || isMerchantOwner(merchantId);
    }

    // Collection-group read for `association_members`: the app resolves "which
    // association does this merchant belong to?" with a collection-group query
    // on `merchant_id`, which the path-scoped rule above does not cover.
    match /{path=**}/association_members/{merchantId} {
      allow read: if true;
    }

    // --- /data_export_requests/{userId} ---
    // GDPR / RGPD — queue for a human-processed email export (optional path).
    // Owner-only; narrow schema so the collection cannot be abused as freeform storage.
    match /data_export_requests/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'requestedAt', 'status'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && (!('email' in request.resource.data)
          || (request.resource.data.email is string
            && request.resource.data.email.size() <= 320))
        && (!('requestedAt' in request.resource.data)
          || request.resource.data.requestedAt is timestamp);
      allow delete: if false;
    }

    // --- /reports/{reportId} ---
    // App Store guideline 1.2: any app with user-generated content needs a
    // reporting mechanism. Writes are append-only by signed-in users; the
    // collection is intentionally NOT readable from the client (admins
    // review via Firebase Console with the Admin SDK).
    //
    // Schema gate enforced server-side so a malicious user can't flood the
    // collection with arbitrary fields:
    //   - reporter_uid must equal the auth uid (no spoofing)
    //   - target_type must be one of a small allowlist
    //   - reason must be in an allowlist (UI restricts the picker)
    //   - message is optional, capped at 500 chars
    //   - created_at must be a server timestamp
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if isSignedIn()
        && request.resource.data.reporter_uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'reporter_uid', 'target_type', 'target_id',
          'reason', 'message', 'created_at'
        ])
        && request.resource.data.target_type is string
        && request.resource.data.target_type in [
          'merchant', 'promotion', 'notification', 'user'
        ]
        && request.resource.data.target_id is string
        && request.resource.data.target_id.size() > 0
        && request.resource.data.target_id.size() <= 128
        && request.resource.data.reason is string
        && request.resource.data.reason in [
          'spam', 'harassment', 'inappropriate', 'fraud',
          'fake_business', 'other'
        ]
        && (!('message' in request.resource.data)
          || (request.resource.data.message is string
            && request.resource.data.message.size() <= 500))
        && request.resource.data.created_at is timestamp;
    }
  }
}
