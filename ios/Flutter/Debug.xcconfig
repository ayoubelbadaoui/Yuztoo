// Pods under ios/Pods; ../ from ios/Flutter/ (SRCROOT not expanded in #include paths).
#include? "../Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"
// Override Flutter Generated.xcconfig (EXCLUDED_ARCHS sim = i386 arm64 — breaks Apple Silicon + Pod linking).
EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386
