// Include Pods-Runner.profile (Flutter Profile / CocoaPods integration).
// Pods path is relative to ios/Flutter/.
#include? "../Pods/Target Support Files/Pods-Runner/Pods-Runner.profile.xcconfig"
#include "Generated.xcconfig"
// Override Flutter Generated.xcconfig simulator arch exclusions for Apple Silicon.
EXCLUDED_ARCHS[sdk=iphonesimulator*] = i386
