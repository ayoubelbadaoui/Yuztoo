# Profile: same as Debug/Release — include CocoaPods profile file (avoids pod install warning).
# Pods live under ios/Pods; path is relative to this file in ios/Flutter/.
#include? "../Pods/Target Support Files/Pods-Runner/Pods-Runner.profile.xcconfig"
#include "Generated.xcconfig"
# Clear Pods default EXCLUDED_ARCHS arm64 for simulator (Apple Silicon).
EXCLUDED_ARCHS[sdk=iphonesimulator*] =
