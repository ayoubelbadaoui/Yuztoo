# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  # Do not use global use_modular_headers! — it makes Clang treat Firebase.h as a hard
  # non-modular include inside FlutterFire framework modules (Xcode 16 / iOS 18 SDK).

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Clean per-file compiler flags that include the invalid '-GCC_WARN_INHIBIT_ALL_WARNINGS'
  installer.pods_project.objects
           .select { |obj| obj.respond_to?(:isa) && obj.isa == 'PBXBuildFile' }
           .each do |obj|
             settings = obj.settings
             next unless settings && settings['COMPILER_FLAGS']

             cleaned = settings['COMPILER_FLAGS']
                         .gsub('-GCC_WARN_INHIBIT_ALL_WARNINGS', '')
                         .squeeze(' ')
                         .strip
             settings['COMPILER_FLAGS'] = cleaned
             settings.delete('COMPILER_FLAGS') if cleaned.empty?
           end

  installer.pods_project.build_configurations.each do |config|
    config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end

    # Strip unsupported '-GCC_WARN_INHIBIT_ALL_WARNINGS' flags that trigger
    # "unsupported option '-G'" on iOS simulator toolchains.
    target.build_configurations.each do |config|
      %w[OTHER_CFLAGS OTHER_CPLUSPLUSFLAGS OTHER_SWIFT_FLAGS].each do |flag_key|
        flags = config.build_settings[flag_key]
        next unless flags

        if flags.is_a?(Array)
          config.build_settings[flag_key] =
            flags.map { |f| f.gsub('-GCC_WARN_INHIBIT_ALL_WARNINGS', '').squeeze(' ').strip }.reject(&:empty?)
        elsif flags.is_a?(String)
          config.build_settings[flag_key] =
            flags.gsub('-GCC_WARN_INHIBIT_ALL_WARNINGS', '').squeeze(' ').strip
        end
      end
    end
  end

  # Xcode 16: also set on Runner (user) project so Debug/simulator picks it up consistently.
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |t|
      t.build_configurations.each do |config|
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
    aggregate_target.user_project.save
  end

  # gRPC-Core and gRPC-C++ both ship basic_seq.h; Xcode 15/16 compiles the C++ pod too.
  # - `Traits::template CheckResultAndRunNext<Wrapped>(...)` is valid (has <>).
  # - `Traits::template CallSeqFactory(...)` is INVALID for Clang (needs <> after `template`).
  %w[
    gRPC-Core/src/core/lib/promise/detail/basic_seq.h
    gRPC-C++/src/core/lib/promise/detail/basic_seq.h
  ].each do |rel|
    grpc_basic_seq = File.join(installer.sandbox.root, rel)
    next unless File.exist?(grpc_basic_seq)

    File.chmod(0o644, grpc_basic_seq) unless File.writable?(grpc_basic_seq)
    text = File.read(grpc_basic_seq)
    text = text.gsub('Traits::CheckResultAndRunNext', 'Traits::template CheckResultAndRunNext')
    text = text.gsub('Traits::template CallSeqFactory', 'Traits::CallSeqFactory')
    File.write(grpc_basic_seq, text)
  end
end
