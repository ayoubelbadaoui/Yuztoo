# Firebase tooling (optional; npm install in tools/firebase)
tools/firebase/node_modules/

# Firebase CLI deploy cache
.firebase/

# Hosted APK build artifact (large; deployed from public/ but not committed)
public/downloads/*.apk

# Emulator debug logs
firestore-debug.log
ui-debug.log

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local dev scripts
send-test-notification.js

# Android release signing (never commit secrets)
android/key.properties
**/*.jks
**/*.keystore
upload-keystore.jks

# Test-only Apple signing material (never commit keys)
.test_signing/
apple_distribution.*
