rules_version = '2';

// Yuztoo — Firebase Storage security rules
//
// Deploy: firebase deploy --only storage
// Paths covered:
//   merchants/{merchantId}/logo.png          — merchant logo
//   merchants/{merchantId}/banner.png        — merchant banner
//   merchants/{merchantId}/news/{file}       — news/gallery images
//   merchants/{merchantId}/promotions/{file} — promotion images
//   users/{userId}/avatar.jpg                — client avatar

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /// Verify the authenticated user owns the given merchant document.
    /// The merchant doc id equals the owner uid, and onboarding uploads the
    /// logo/banner before that doc is created, so the uid match must not
    /// depend on the Firestore read.
    function isMerchantOwner(merchantId) {
      return isOwnerUid(merchantId)
        || (isSignedIn()
          && firestore.exists(/databases/(default)/documents/merchants/$(merchantId))
          && firestore.get(/databases/(default)/documents/merchants/$(merchantId)).data.owner_uid
               == request.auth.uid);
    }

    /// Enseigne owner or gérant of this store (see firestore.rules
    /// `hasStoreRole`). Stores without `organization_id` stop at the first
    /// check, so single-store merchants are unaffected.
    function merchantDoc(merchantId) {
      return firestore.get(/databases/(default)/documents/merchants/$(merchantId)).data;
    }

    function storeMemberDoc(merchantId) {
      return firestore.get(/databases/(default)/documents/organizations/$(merchantDoc(merchantId).organization_id)/members/$(request.auth.uid)).data;
    }

    function isStoreManager(merchantId) {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/merchants/$(merchantId))
        && merchantDoc(merchantId).get('organization_id', null) is string
        && firestore.exists(/databases/(default)/documents/organizations/$(merchantDoc(merchantId).organization_id)/members/$(request.auth.uid))
        && storeMemberDoc(merchantId).status == 'active'
        && (storeMemberDoc(merchantId).role == 'owner'
          || (storeMemberDoc(merchantId).role == 'manager'
            && merchantId in storeMemberDoc(merchantId).get('store_ids', [])));
    }

    function canManageStore(merchantId) {
      return isMerchantOwner(merchantId) || isStoreManager(merchantId);
    }

    /// 5 MB file size cap for all uploads.
    function sizeOk() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    /// Accepted image MIME types.
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // ── Merchant assets ────────────────────────────────────────────────────

    // Logo / banner (single file per merchant)
    match /merchants/{merchantId}/logo.png {
      allow read: if true;
      allow create, update: if canManageStore(merchantId) && sizeOk() && isImage();
      allow delete: if canManageStore(merchantId);
    }

    match /merchants/{merchantId}/banner.png {
      allow read: if true;
      allow create, update: if canManageStore(merchantId) && sizeOk() && isImage();
      allow delete: if canManageStore(merchantId);
    }

    // News / gallery slider images  (merchants/{merchantId}/news/{file})
    match /merchants/{merchantId}/news/{file} {
      allow read: if true;
      allow create, update: if canManageStore(merchantId) && sizeOk() && isImage();
      allow delete: if canManageStore(merchantId);
    }

    // Promotion images  (merchants/{merchantId}/promotions/{file})
    match /merchants/{merchantId}/promotions/{file} {
      allow read: if true;
      allow create, update: if canManageStore(merchantId) && sizeOk() && isImage();
      allow delete: if canManageStore(merchantId);
    }

    // ── Client / user assets ───────────────────────────────────────────────

    // Client avatar
    match /users/{userId}/avatar.jpg {
      allow read: if true;
      allow create, update: if isOwnerUid(userId) && sizeOk() && isImage();
      allow delete: if isOwnerUid(userId);
    }

    // ── Default deny ───────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
