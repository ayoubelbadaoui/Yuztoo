# Public only — never put the service role / Meta app secret here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: Actu CMS offline mock (localStorage). Default = live Edge → Firebase.
# VITE_CMS_ACTU_MOCK=1

# Meta + Actu bridge secrets live in Supabase Edge Function secrets, not VITE_*:
# META_APP_ID, META_APP_SECRET, META_OAUTH_REDIRECT_URI,
# META_WEBHOOK_VERIFY_TOKEN, CRM_APP_ORIGIN
# CRM_BRIDGE_SECRET, FIREBASE_PROJECT_ID=yuztoo
# (optional) CRM_BRIDGE_YUZTOO_NEWS_URL=https://europe-west1-yuztoo.cloudfunctions.net/crmBridgeYuztooNews
