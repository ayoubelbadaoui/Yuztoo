{
  "private": true,
  "name": "yuztoo-firebase-rules",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.13.2",
    "firebase-tools": "^12.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "@types/jest": "^29.5.13",
    "typescript": "^5.5.4"
  },
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore --project demo-yuztoo \"npx jest rules --testPathPattern=firestore_rules --forceExit\" 2>&1",
    "rules:emulator": "cd ../.. && firebase emulators:start --only firestore --project demo-yuztoo"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "forceExit": true
  }
}
